# Copy this file to .env.local and supply the values from your Supabase project.
# These EXPO_PUBLIC_ values are bundled into the client app. Use only the
# Supabase project URL and anon/publishable key here; NEVER put service_role
# keys, database passwords, or other private server secrets in this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
